APP_NAME=Petroil Project Manager API
DEBUG=false
POSTGRES_USER=petroil
POSTGRES_PASSWORD=petroil
POSTGRES_DB=petroil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Si se define, tiene prioridad sobre las variables POSTGRES_*
# DATABASE_URL=postgresql+asyncpg://petroil:petroil@localhost:5432/petroil
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Autenticación (Firebase Auth). En false, todas las peticiones actúan como la persona de LOCAL_ID_USUARIO (o un Administrador local).
AUTH_ENABLED=false
# Firma de las sesiones con contraseña; obligatoria con AUTH_ENABLED=true (mín. 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESION_HORAS=12
# Solo con AUTH_ENABLED=false: id de la persona del Equipo con la que actúa la sesión local
# (para usar "Mi perfil", "Mis tareas" y menciones). con el rol de acceso de esa persona. Vacío: Administrador local.
LOCAL_ID_USUARIO=
FIREBASE_PROJECT_ID=innovacion-futuro
# Correos con acceso de Administrador aunque no estén aún en el Equipo (JSON)
BOOTSTRAP_ADMIN_EMAILS=[]
